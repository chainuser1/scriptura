# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local artifact packs and historical data; never commit model/corpus/user data.
/.artifact-staging/
/generated-artifacts/
/local-benchmarks/
/assets/resources/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.onnx
*.onnx_data
*.npz
*.npy
*.safetensors
*.pt
*.zip
__pycache__/
.venv/
.env
.env.*
!.env.example

# Synthetic test fixtures are small, schema-faithful and contain no scripture text (PLAN 12.3).
!/test/fixtures/*.db

/legacy-quarantine/

# Rust engine build output
/engine/target/

# Native libraries staged by tool/build_engine_android.py
/android/app/src/main/jniLibs/
android/.kotlin/

# Android release signing: keystores and their passwords never enter git
/android/key.properties
*.jks
*.keystore

# executor scratch
.superpowers/

# Kaggle scratch: scripture data/zips never enter git, but its scripts are source worth keeping
/.kaggle-package/data/
/.kaggle-package/data-heldout/
/.kaggle-package/*.zip
